{
 "version": 2,
 "outputDirectory": "public",
 "functions": {
  "api/*.js": {
   "maxDuration": 60
  }
 },
 "headers": [
  {
   "source": "/version.json",
   "headers": [
    {"key": "Cache-Control", "value": "no-store, max-age=0"},
    {"key": "Access-Control-Allow-Origin", "value": "*"}
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "same-origin"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
   ]
  }
 ],
 "cleanUrls": true
}
