# Obligatoire
DATABASE_URL=            # Neon (production) ou postgres://postgres:postgres@localhost:5432/panneau (local)
APP_SECRET=              # Chaîne aléatoire ≥ 32 caractères : signe les liens de téléchargement PDF
# Administration
ADMIN_EMAILS=            # Courriels ayant accès à la console /app#/admin (ex. nathanbegin@gmail.com)
# Codes promo (accès sans paiement) : CODE, CODE:forfait ou CODE:forfait:jours, séparés par des virgules
PROMO_CODES=             # Ex. MONCODE2026  (forfait « Accès complet », sans fin)
# Paiements Stripe (le site fonctionne sans : forfait gratuit seulement)
STRIPE_SECRET_KEY=       # sk_test_… puis sk_live_…
STRIPE_WEBHOOK_SECRET=   # whsec_… (point de terminaison https://VOTRE-DOMAINE/api/stripe-webhook)
STRIPE_TAX=              # 1 pour activer le calcul automatique TPS/TVQ (Stripe Tax)
# Facultatif
APP_URL=                 # URL publique (ex. https://monpanneau.ca), utilisée dans les courriels
RESEND_API_KEY=          # Active « Mot de passe oublié » (https://resend.com)
MAIL_FROM=               # Ex. Mon Panneau <noreply@monpanneau.ca>
ALLOWED_ORIGINS=         # Origines CORS supplémentaires, séparées par des virgules
PANELS_API_KEY=          # Active l'envoi vers ZebraHD
# Ancienne version 1.x (interface /ancien/ et import dans un compte)
PANEL_ACCESS_KEY=
